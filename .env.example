# Copy to .env (git-ignored) and fill in.

# --- Qwen 3.5 2B report service (Kaggle notebook rudraksh12/qwen3-5) ---
# Notebook launch cell: kaggle/qwen_service_launch_cell.py
# QWEN_ENDPOINT: your fixed ngrok domain (best), or the current gradio.live link.
QWEN_ENDPOINT=
# QWEN_DISCOVERY: same topic as the notebook's SIMGUARD_TOPIC secret; the backend then finds
# each new gradio.live link by itself. A link pasted in the UI (click the Qwen pill) also works.
QWEN_DISCOVERY=ntfy:simguard-2511bfdb6ca0500b
QWEN_USER=simguard
QWEN_PASSWORD=
QWEN_TIMEOUT_S=90
# Qwen reports written automatically per upload (flagged first); the rest on demand in the UI.
QWEN_MAX_AUTO_REPORTS=3

# --- Laya (fine-tuned) ---
# LAYA_MODEL=finetune/fraud_v2/runs/20261113_171802_a1_6ep/final
LAYA_DEVICE=auto
LAYA_FRAUD_THRESHOLD=0.5
LAYA_WEIGHT=0.7
LAYA_PRELOAD=1

# --- misc ---
MOCK_MODELS=0
DB_PATH=simguard.db
